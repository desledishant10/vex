# Vex environment variables
# Copy this file to .env and fill in real values, then source it (Vex does not
# auto-load .env). NEVER commit .env to git.

# Provider API keys (only set what you use). Read by the provider SDKs.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Ollama host (read by the Ollama provider; defaults to http://localhost:11434).
OLLAMA_HOST=http://localhost:11434
